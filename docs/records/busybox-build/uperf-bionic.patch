--- a/libbb/yescrypt/alg-yescrypt-common.c
+++ b/libbb/yescrypt/alg-yescrypt-common.c
@@ -1,3 +1,14 @@
+/* uperf-libre build patch: bionic has no explicit_bzero().
+ * Zeroing a buffer is what explicit_bzero compiles to on a libc without it, and these
+ * are yescrypt scratch buffers (busybox only reaches them from passwd/cryptpw, which
+ * this build does not enable). Applied by docs/records/busybox-build/build-busybox.sh. */
+#if defined(__ANDROID__)
+# include <string.h>
+# ifndef explicit_bzero
+#  define explicit_bzero(p, n) memset((p), 0, (n))
+# endif
+#endif
+
